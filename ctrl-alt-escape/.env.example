# Copy to .env and fill in. Never commit .env.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Firebase service-account key: file path (relative to ctrl-alt-escape/) ...
FIREBASE_CREDENTIALS=serviceAccountKey.json
# ... or the key's full JSON contents (for hosts like Render/Railway)
# FIREBASE_CREDENTIALS_JSON=

# Path to the registration sheet (columns: name, roll number, email, eligibility)
PARTICIPANT_CSV_PATH=./data/Event_Registration.xlsx
